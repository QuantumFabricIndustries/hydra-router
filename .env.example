# HYDRA Router Configuration

# Server
PORT=3000
HYDRA_API_KEY=your-hydra-api-key-here

# Model Provider Keys
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
GEMINI_API_KEY=your-gemini-key

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Router config file path (optional, defaults to ./config/routing.json)
ROUTING_CONFIG=./config/routing.json
