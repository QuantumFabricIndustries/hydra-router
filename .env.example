# HYDRA Router Configuration

# Server
PORT=3000
# Single key (backwards-compatible)
HYDRA_API_KEY=your-hydra-api-key-here
# OR multiple keys for different callers (comma-separated; takes priority over HYDRA_API_KEY)
# HYDRA_API_KEYS=key-for-service-a,key-for-service-b
# Set to 'true' ONLY for local dev when you want to disable auth entirely (no keys needed)
# HYDRA_AUTH_DISABLED=true

# Model Provider Keys
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
GEMINI_API_KEY=your-gemini-key

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Router config file path (optional, defaults to ./config/routing.json)
ROUTING_CONFIG=./config/routing.json
