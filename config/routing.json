      "latencyClass": "fast"
    }
  },
  "rules": [
    {
      "name": "force-local-cheap",
      "priority": 1,
      "conditions": [
        { "field": "tag", "operator": "contains", "value": "local" }
      ],
      "target": "local"
    },
    {
      "name": "simple-short-to-cheap",
      "priority": 10,
      "conditions": [
        { "field": "complexity", "operator": "lt", "value": 25 },
        { "field": "token_count", "operator": "lt", "value": 500 }
      ],
      "target": "gpt-fast",
      "fallback": "claude-fast"
    },
    {
      "name": "medium-complexity",
      "priority": 20,
      "conditions": [
        { "field": "complexity", "operator": "gte", "value": 25 },
        { "field": "complexity", "operator": "lt", "value": 65 }
      ],
      "target": "claude-smart",
      "fallback": "gpt-smart"
    },
    {
      "name": "high-complexity-reasoning",
      "priority": 30,
      "conditions": [
        { "field": "complexity", "operator": "gte", "value": 65 }
      ],
      "target": "claude-power",
      "fallback": "claude-smart"
    },
    {
      "name": "long-context-gemini",
      "priority": 5,
      "conditions": [
        { "field": "token_count", "operator": "gt", "value": 100000 }
      ],
      "target": "gemini-smart",
      "fallback": "claude-smart"
    },
    {
      "name": "budget-constrained",
      "priority": 2,
      "conditions": [
        { "field": "cost_budget", "operator": "lt", "value": 0.005 }
      ],
      "target": "gpt-fast",
      "fallback": "claude-fast"
    }
  ],
  "defaultModel": "claude-smart"
}
