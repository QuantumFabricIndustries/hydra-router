{
  "name": "hydra-router",
  "version": "1.0.0",
  "description": "Multi-model AI traffic controller — route queries to Claude, GPT, Gemini, or local models based on cost, latency, and complexity rules",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["ai", "router", "llm", "multi-model", "proxy"],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "express": "^4.18.2",
    "openai": "^4.28.0",
    "zod": "^3.22.4",
    "tiktoken": "^1.0.15",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
